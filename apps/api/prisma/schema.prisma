generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  password         String
  createdAt        DateTime          @default(now())
  firstName        String
  lastName         String
  role             UserRole          @default(USER)
  updatedAt        DateTime          @updatedAt
  answers          Answer[]          @relation("NurseAnswers")
  nurseProfile     NurseProfile?
  questions        Question[]        @relation("UserQuestions")
  consultations    Consultation[]
  notifications    Notification[]
  // ==========================
  // Knowledge Engine
  // ==========================
  contents         Content[]
  contentComments  ContentComment[]
  contentBookmarks ContentBookmark[]
  contentLikes     ContentLike[]
}

model NurseProfile {
  id                 String   @id @default(cuid())

  userId             String   @unique

  bio                String?

  yearsExperience    Int?

  consultationFee    Float?

  verified           Boolean @default(false)

  verificationStatus NurseVerificationStatus @default(PENDING)

  rejectionReason    String?

  approvedAt         DateTime?

  approvedBy         String?

  createdAt          DateTime @default(now())

  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  specialties NurseSpecialty[]
}

model Specialty {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  nurses NurseSpecialty[]
}

model NurseSpecialty {
  nurseProfileId String
  specialtyId    String

  nurseProfile NurseProfile @relation(fields: [nurseProfileId], references: [id])
  specialty    Specialty    @relation(fields: [specialtyId], references: [id])

  @@id([nurseProfileId, specialtyId])
}

model HealthTopic {
  id String @id @default(cuid())

  title String
  slug  String @unique

  summary String

  content String @db.Text

  category String

  image String?

  featured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Question {
  id         String             @id @default(cuid())
  title      String
  content    String
  createdAt  DateTime           @default(now())
  status     QuestionStatus     @default(PENDING)
  updatedAt  DateTime           @updatedAt
  userId     String
  visibility QuestionVisibility
  answer     Answer?
  user       User               @relation("UserQuestions", fields: [userId], references: [id])
}

model Answer {
  id         String   @id @default(cuid())
  nurseId    String
  content    String
  createdAt  DateTime @default(now())
  questionId String   @unique
  nurse      User     @relation("NurseAnswers", fields: [nurseId], references: [id])
  question   Question @relation(fields: [questionId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Consultation {
  id String @id @default(cuid())

  userId      String
  topic       String
  description String

  status ConsultationStatus @default(PENDING)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// =====================================================
// KNOWLEDGE ENGINE
// =====================================================

model Content {
  id String @id @default(cuid())

  title String
  slug  String @unique

  excerpt String

  content String @db.Text

  coverImage String?

  readingTime Int @default(3)

  featured Boolean @default(false)

  published Boolean @default(false)

  type ContentType @default(ARTICLE)

  views Int @default(0)

  authorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])

  taxonomies ContentTaxonomy[]

  comments ContentComment[]

  bookmarks ContentBookmark[]

  likes ContentLike[]
}

model Taxonomy {
  id String @id @default(cuid())

  name String

  slug String @unique

  description String?

  color String?

  icon String?

  type TaxonomyType

  createdAt DateTime @default(now())

  contents ContentTaxonomy[]

  @@unique([name, type])
}

model ContentTaxonomy {
  contentId String

  taxonomyId String

  content Content @relation(fields: [contentId], references: [id])

  taxonomy Taxonomy @relation(fields: [taxonomyId], references: [id])

  @@id([contentId, taxonomyId])
}

model ContentComment {
  id String @id @default(cuid())

  contentId String

  userId String

  content String @db.Text

  createdAt DateTime @default(now())

  article Content @relation(fields: [contentId], references: [id])

  user User @relation(fields: [userId], references: [id])
}

model ContentBookmark {
  contentId String

  userId String

  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id])

  user User @relation(fields: [userId], references: [id])

  @@id([contentId, userId])
}

model ContentLike {
  contentId String

  userId String

  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id])

  user User @relation(fields: [userId], references: [id])

  @@id([contentId, userId])
}

enum ConsultationStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum UserRole {
  USER
  NURSE
  ADMIN
}

enum QuestionVisibility {
  PRIVATE
  PUBLIC
}

enum QuestionStatus {
  PENDING
  ANSWERED
}

enum ContentType {
  ARTICLE
  HEALTH_TIP
  ANNOUNCEMENT
  NEWS
  GUIDE
}

enum TaxonomyType {
  CATEGORY
  TAG
  SPECIALTY
}

enum NurseVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}